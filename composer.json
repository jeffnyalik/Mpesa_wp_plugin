{
	"name": "plug-one/mpesa-woocommerce",
	"description": "Lipa Na M-Pesa STK Push gateway for WooCommerce",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"freemius/wordpress-sdk": "^2.12"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"config": {
		"allow-plugins": {
			"freemius/wordpress-sdk": true
		}
	},
	"autoload-dev": {
		"psr-4": {
			"PlugOne\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
